<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>StreamCell</AssemblyName><RootNamespace>StreamCell</RootNamespace><ApplicationIcon>StreamCell.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget><Optimize>true</Optimize><LangVersion>5</LangVersion>
    <ApplicationManifest>StreamCell.manifest</ApplicationManifest><OutputPath>build\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" /><Reference Include="Microsoft.Web.WebView2.Core"><HintPath>vendor\webview2\Microsoft.Web.WebView2.Core.dll</HintPath></Reference><Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>vendor\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference><Reference Include="System.Security" />
    <Compile Include="Program.cs" /><Compile Include="ConfigStore.cs" /><Compile Include="DesktopActions.cs" /><Compile Include="ObsBridge.cs" /><Compile Include="DesktopHost.cs" />
    <EmbeddedResource Include="vendor\webview2\*.dll"><LogicalName>StreamCell.Runtime.%(Filename)%(Extension)</LogicalName></EmbeddedResource><EmbeddedResource Include="wwwroot\*"><LogicalName>StreamCell.Assets.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
